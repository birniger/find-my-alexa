{
  "name": "device-finder-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --outdir worker-dist",
    "deploy": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --local",
    "types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "jose": "6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "typescript": "5.9.3",
    "wrangler": "4.119.0"
  }
}
